generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cart {
  cartId            String                @id
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  cartCode          String                @unique @default(cuid())
  operationalStatus CartOperationalStatus @default(ACTIVE)
  qrCodeUrl         String?
  sessions          ShoppingSession[]
}

model Product {
  id              String     @id @default(cuid())
  name            String
  price           Decimal    @db.Decimal(10, 2)
  expectedWeight  Float
  weightTolerance Float      @default(15)
  createdAt       DateTime   @default(now())
  isAvailable     Boolean    @default(true)
  rfidUid         String     @unique
  updatedAt       DateTime   @updatedAt
  cartItems       CartItem[]
}

model ShoppingSession {
  id                    String        @id @default(cuid())
  cartId                String
  status                SessionStatus @default(ACTIVE)
  startedAt             DateTime      @default(now())
  completedAt           DateTime?
  totalPrice            Decimal       @default(0) @db.Decimal(10, 2)
  totalExpectedWeight   Float         @default(0)
  currentMeasuredWeight Float         @default(0)
  hasMismatch           Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  items                 CartItem[]
  scanEvents            ScanEvent[]
  cart                  Cart          @relation(fields: [cartId], references: [cartId], onDelete: Cascade)
  transaction           Transaction?

  @@index([cartId, status])
}

model CartItem {
  id                     String          @id @default(cuid())
  productId              String
  quantity               Int
  subtotal               Decimal         @db.Decimal(10, 2)
  createdAt              DateTime        @default(now())
  expectedWeightSnapshot Float
  productNameSnapshot    String
  sessionId              String
  unitPriceSnapshot      Decimal         @db.Decimal(10, 2)
  updatedAt              DateTime        @updatedAt
  product                Product         @relation(fields: [productId], references: [id])
  session                ShoppingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, productId])
  @@index([sessionId])
}

model ScanEvent {
  id             String          @id @default(cuid())
  eventId        String          @unique
  sessionId      String
  rfidUid        String
  action         ScanAction      @default(ADD)
  measuredWeight Float
  scanResult     ScanResult
  timestamp      DateTime        @default(now())
  session        ShoppingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, timestamp])
  @@index([eventId])
}

model Transaction {
  id                 String          @id @default(cuid())
  sessionId          String          @unique
  subtotal           Decimal         @db.Decimal(10, 2)
  tax                Decimal         @default(0) @db.Decimal(10, 2)
  discount           Decimal         @default(0) @db.Decimal(10, 2)
  finalTotal         Decimal         @db.Decimal(10, 2)
  paymentMethod      String?
  paymentStatus      PaymentStatus   @default(PENDING)
  reference          String?         @unique
  timestamp          DateTime        @default(now())
  billNumber         String          @unique @default(dbgenerated("('BILL-'::text || substr(md5((random())::text), 1, 10))"))
  billStatus         BillStatus      @default(PENDING)
  cashierConfirmedAt DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @default(now()) @updatedAt
  session            ShoppingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

enum CartOperationalStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
  BILL_GENERATED
  PAYMENT_PENDING
}

enum ScanAction {
  ADD
  REMOVE
}

enum ScanResult {
  SUCCESS
  MISMATCH
  UNKNOWN_TAG
  DUPLICATE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum BillStatus {
  PENDING
  PAID
  CANCELLED
}
